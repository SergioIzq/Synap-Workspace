{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "[B]ash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search || exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
