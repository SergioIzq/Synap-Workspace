# Copy to .env and fill in real values. Never commit the real .env file.

POSTGRES_DB=synap
POSTGRES_USER=synap
POSTGRES_PASSWORD=

ASPNETCORE_ENVIRONMENT=Production

# Signs session JWTs (JwtSettings:SecretKey) - generate with e.g. `openssl rand -base64 48`.
JWT_SECRET_KEY=

# Shared secret between synap-api and synap-ai for their internal-only HTTP calls - generate the
# same way as JWT_SECRET_KEY. Not meant to be reachable from outside the Docker network.
INTERNAL_API_KEY=

# Encrypts each user's own Groq API key at rest (AES-256-GCM) - must be exactly 32 bytes, base64.
# Generate with `openssl rand -base64 32` and BACK IT UP: if it's lost, every stored Groq key
# becomes unreadable and users have to enter theirs again.
SECRETS_ENCRYPTION_KEY=

# There is no server-owned Groq API key: each user configures their own in Settings, so the
# assistant never costs the owner anything. This is only the default model for users who
# haven't chosen one.
GROQ_MODEL=qwen/qwen3.8-27b

# IP(s) of the reverse proxy in front of synap-api (comma-separated) - only its X-Forwarded-For
# is trusted for the per-IP login/register rate limit. See docs/deployment-runbook.md section 9.
FORWARDED_KNOWN_PROXIES=

# Public URL of the web app (no trailing slash) - used in the links of password-recovery emails.
PUBLIC_BASE_URL=https://synap.sergioizq.com

# Brevo SMTP credentials for transactional email (password recovery). Get them in Brevo >
# SMTP & API. Leave empty to run without email (recovery requests then send nothing).
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
