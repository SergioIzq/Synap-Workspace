# Copy to .env and fill in real values. Never commit the real .env file.

POSTGRES_DB=synap
POSTGRES_USER=synap
POSTGRES_PASSWORD=

ASPNETCORE_ENVIRONMENT=Production

# Signs session JWTs (JwtSettings:SecretKey) - generate with e.g. `openssl rand -base64 48`.
JWT_SECRET_KEY=

# Shared secret between synap-api and synap-ai for their internal-only HTTP calls - generate the
# same way as JWT_SECRET_KEY. Not meant to be reachable from outside the Docker network.
INTERNAL_API_KEY=

# Groq free-tier API key for the assistant's answer generation (design.md Decision 2). Leave
# empty during early setup - only the "ask the assistant" feature needs it; capture/search/
# embeddings/related-notes all work without it.
GROQ_API_KEY=
